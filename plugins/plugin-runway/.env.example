# Required for Runway API calls (org secret from https://dev.runwayml.com)
RUNWAYML_API_SECRET=

# Optional: override API host (must resolve to a path ending in /v1)
# RUNWAYML_API_BASE_URL=https://api.dev.runwayml.com/v1
# RUNWAYML_BASE_URL=https://api.dev.runwayml.com

# Characters defaults (see Runway Characters docs)
# RUNWAY_CHARACTER_AVATAR_TYPE=runway-preset
# RUNWAY_CHARACTER_AVATAR_ID=music-superstar
