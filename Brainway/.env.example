# Copy to .env or .env.local for local dev (never commit real secrets).

# Required for Runway video, transforms, and Characters sessions.
RUNWAYML_API_SECRET=

# Optional API base (omit to use SDK defaults).
# RUNWAYML_API_BASE_URL=https://api.dev.runwayml.com/v1

# Characters realtime: default avatar when not overridden per request.
RUNWAY_CHARACTER_AVATAR_ID=music-superstar

# Use "custom" + a custom avatar ID from your Runway org so ADHD / autism /
# dyslexia / sensory rules in src/lib/character-personality.ts are sent as
# personality + startScript on /live and /meet. Preset avatars ignore those fields.
# Recall.ai bridge (optional): HTTPS origin of recall-bridge Node service — enables
# "Send Character to Meeting" on /meet (Zoom / Meet / Teams bot).
# RECALL_BRIDGE_URL=https://your-recall-bridge.example.com
