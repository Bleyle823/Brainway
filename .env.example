# Local dev environment variables (Node.js / Vite dev server)
# Copy to .env.local and fill in real values. Never commit secrets to git.

# Runway API key — get one at https://dev.runwayml.com
RUNWAYML_API_SECRET=your_runway_api_key_here

# Characters / live sessions (optional)
# Preset character id from Developer Portal (default in code: music-superstar)
RUNWAY_CHARACTER_AVATAR_ID=music-superstar
# preset | custom — use "custom" with a portal-created character UUID
RUNWAY_CHARACTER_AVATAR_TYPE=preset

